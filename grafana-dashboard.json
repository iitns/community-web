{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource"
    }
  ],
  "__requires": [
    {"type": "datasource", "id": "grafana-clickhouse-datasource", "name": "ClickHouse", "version": "1.0.0"}
  ],
  "title": "Community Web Analytics",
  "uid": "community-web-analytics",
  "tags": ["analytics", "community-web"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "오늘 페이지뷰",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT count() AS value FROM analytics.raw_events WHERE event = '$pageview' AND received_at >= toStartOfDay(now())",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}
    },
    {
      "id": 2,
      "title": "오늘 방문자",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT uniq(distinct_id) AS value FROM analytics.raw_events WHERE event = '$pageview' AND received_at >= toStartOfDay(now())",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 3,
      "title": "7일 페이지뷰",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT count() AS value FROM analytics.raw_events WHERE event = '$pageview' AND received_at >= now() - INTERVAL 7 DAY",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}
    },
    {
      "id": 4,
      "title": "7일 방문자",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT uniq(distinct_id) AS value FROM analytics.raw_events WHERE event = '$pageview' AND received_at >= now() - INTERVAL 7 DAY",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 5,
      "title": "시간대별 페이지뷰",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT toStartOfHour(received_at) AS time, count() AS pageviews, uniq(distinct_id) AS visitors FROM analytics.raw_events WHERE event = '$pageview' AND $__timeFilter(received_at) GROUP BY time ORDER BY time",
        "format": 0,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 6,
      "title": "인기 페이지",
      "type": "table",
      "gridPos": {"x": 0, "y": 12, "w": 14, "h": 8},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT JSONExtractString(properties, '$pathname') AS 경로, count() AS 페이지뷰, uniq(distinct_id) AS 방문자 FROM analytics.raw_events WHERE event = '$pageview' AND $__timeFilter(received_at) GROUP BY 경로 ORDER BY 페이지뷰 DESC LIMIT 20",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"sortBy": [{"displayName": "페이지뷰", "desc": true}]}
    },
    {
      "id": 7,
      "title": "기기 유형",
      "type": "piechart",
      "gridPos": {"x": 14, "y": 12, "w": 5, "h": 8},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT if(JSONExtractString(properties, '$device_type') = '', 'Unknown', JSONExtractString(properties, '$device_type')) AS device, count() AS cnt FROM analytics.raw_events WHERE event = '$pageview' AND $__timeFilter(received_at) GROUP BY device ORDER BY cnt DESC",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"pieType": "pie", "tooltip": {"mode": "single"}}
    },
    {
      "id": 8,
      "title": "브라우저",
      "type": "piechart",
      "gridPos": {"x": 19, "y": 12, "w": 5, "h": 8},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT if(JSONExtractString(properties, '$browser') = '', 'Unknown', JSONExtractString(properties, '$browser')) AS browser, count() AS cnt FROM analytics.raw_events WHERE event = '$pageview' AND $__timeFilter(received_at) GROUP BY browser ORDER BY cnt DESC",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"pieType": "donut", "tooltip": {"mode": "single"}}
    },
    {
      "id": 9,
      "title": "최근 이벤트",
      "type": "table",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "grafana-clickhouse-datasource", "uid": "${DS_CLICKHOUSE}"},
        "rawSql": "SELECT received_at AS 시각, event AS 이벤트, distinct_id AS 방문자ID, JSONExtractString(properties, '$current_url') AS URL, JSONExtractString(properties, '$browser') AS 브라우저, JSONExtractString(properties, '$os') AS OS FROM analytics.raw_events WHERE $__timeFilter(received_at) ORDER BY received_at DESC LIMIT 50",
        "format": 1,
        "meta": {"builderOptions": {"mode": "raw"}}
      }],
      "options": {"sortBy": [{"displayName": "시각", "desc": true}]}
    }
  ]
}
